// -----------------------------------------------------------------------------
// Principes repris du socle validÃ© :
//   - Multi-tenant : chaque modÃ¨le mÃ©tier porte hopitalId (isolation par clinique)
//   - Offline-first : UUID gÃ©nÃ©rÃ©s cÃ´tÃ© client, createdAt/updatedAt/deletedAt +
//     rowVersion pour la dÃ©tection de conflits Ã  la synchro
//   - Facturation Mobile Money : paiements rÃ©fÃ©rencÃ©s Ã  Campay
//
// Ã€ COMPLÃ‰TER PAR UNE MIGRATION SQL MANUELLE (Prisma ne sait pas les exprimer) :
//   1. Row-Level Security (RLS) : politiques d'isolation par hopital_id
//   2. Trigger d'auto-incrÃ©ment de row_version Ã  chaque UPDATE
//   3. Colonne calculÃ©e `montant` de LigneFacture (sinon la calculer cÃ´tÃ© appli)
//   -> je fournis cette migration sÃ©parÃ©ment sur demande.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------- Enums ----------------------------------------

enum Sexe {
  M
  F
}

enum StatutRdv {
  planifie
  confirme
  honore
  annule
  absent
}

enum OrigineRdv {
  clinique
  patient
}

enum StatutFacture {
  ouverte
  partielle
  reglee
  annulee
}

enum MoyenPaiement {
  mobile_money
  especes
}

enum CanalRappel {
  whatsapp
  sms
}

enum StatutRappel {
  en_attente
  envoye
  echec
}

// ----------------------------- Tenant ---------------------------------------

model Hopital {
  id           String    @id @default(uuid()) @db.Uuid
  nom          String
  code         String    @unique @db.Citext
  ville        String?
  telephone    String?
  campayAppId  String?   @map("campay_app_id")
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion   Int       @default(0) @map("row_version")

  utilisateurs  Utilisateur[]
  roles         Role[]
  services      Service[]
  unitesSoins   UniteSoins[]
  praticiens    Praticien[]
  actes         Acte[]
  tarifs        Tarif[]
  patients      Patient[]
  rendezVous    RendezVous[]
  consultations Consultation[]
  factures      Facture[]
  lignesFacture LigneFacture[]
  paiements     Paiement[]
  rappels       Rappel[]
  journalAudit  JournalAudit[]

  @@map("hopitaux")
}

// ----------------------------- RBAC -----------------------------------------

model Utilisateur {
  id                String    @id @default(uuid()) @db.Uuid
  hopitalId         String    @map("hopital_id") @db.Uuid
  email             String    @db.Citext
  motDePasse        String    @map("mot_de_passe") // hash argon2/bcrypt
  nom               String
  prenom            String?
  telephone         String?
  actif             Boolean   @default(true)
  derniereConnexion DateTime? @map("derniere_connexion") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion        Int       @default(0) @map("row_version")

  hopital    Hopital           @relation(fields: [hopitalId], references: [id])
  roles      UtilisateurRole[]
  praticiens Praticien[]
  audit      JournalAudit[]

  @@unique([hopitalId, email])
  @@map("utilisateurs")
}

model Role {
  id         String   @id @default(uuid()) @db.Uuid
  hopitalId  String   @map("hopital_id") @db.Uuid
  code       String
  libelle    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion Int      @default(0) @map("row_version")

  hopital     Hopital           @relation(fields: [hopitalId], references: [id])
  permissions RolePermission[]
  utilisateurs UtilisateurRole[]

  @@unique([hopitalId, code])
  @@map("roles")
}

model Permission {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String
  module  String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UtilisateurRole {
  utilisateurId String @map("utilisateur_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, roleId])
  @@map("utilisateur_roles")
}

// --------------------------- RÃ©fÃ©rentiels -----------------------------------

model Service {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  libelle    String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital     Hopital        @relation(fields: [hopitalId], references: [id])
  unitesSoins UniteSoins[]
  praticiens  Praticien[]
  rendezVous  RendezVous[]

  @@map("services")
}

model UniteSoins {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  serviceId  String?   @map("service_id") @db.Uuid
  libelle    String
  nbLits     Int       @default(0) @map("nb_lits")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital Hopital  @relation(fields: [hopitalId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("unites_soins")
}

model Praticien {
  id            String    @id @default(uuid()) @db.Uuid
  hopitalId     String    @map("hopital_id") @db.Uuid
  utilisateurId String?   @map("utilisateur_id") @db.Uuid
  serviceId     String?   @map("service_id") @db.Uuid
  nom           String
  prenom        String?
  specialite    String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion    Int       @default(0) @map("row_version")

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  utilisateur   Utilisateur?   @relation(fields: [utilisateurId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  rendezVous    RendezVous[]
  consultations Consultation[]

  @@map("praticiens")
}

model Acte {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  code       String
  libelle    String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  tarifs        Tarif[]
  lignesFacture LigneFacture[]

  @@unique([hopitalId, code])
  @@map("actes")
}

model Tarif {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  acteId     String    @map("acte_id") @db.Uuid
  montant    Decimal   @db.Decimal(12, 2)
  devise     String    @default("XAF") @db.Char(3)
  dateDebut  DateTime  @default(now()) @map("date_debut") @db.Date
  dateFin    DateTime? @map("date_fin") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  acte    Acte    @relation(fields: [acteId], references: [id])

  @@map("tarifs")
}

// ----------------------------- Patients -------------------------------------

model Patient {
  id            String    @id @default(uuid()) @db.Uuid
  hopitalId     String    @map("hopital_id") @db.Uuid
  numeroDossier String    @map("numero_dossier")
  nom           String
  prenom        String?
  dateNaissance DateTime? @map("date_naissance") @db.Date
  sexe          Sexe?
  telephone     String?
  adresse       String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion    Int       @default(0) @map("row_version")

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  rendezVous    RendezVous[]
  consultations Consultation[]
  factures      Facture[]

  @@unique([hopitalId, numeroDossier])
  @@index([hopitalId, nom])
  @@index([hopitalId, telephone])
  @@map("patients")
}

// --------------------------- Rendez-vous ------------------------------------

model RendezVous {
  id          String     @id @default(uuid()) @db.Uuid
  hopitalId   String     @map("hopital_id") @db.Uuid
  patientId   String     @map("patient_id") @db.Uuid
  praticienId String?    @map("praticien_id") @db.Uuid
  serviceId   String?    @map("service_id") @db.Uuid
  debut       DateTime   @db.Timestamptz
  fin         DateTime?  @db.Timestamptz
  statut      StatutRdv  @default(planifie)
  origine     OrigineRdv @default(clinique)
  motif       String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz
  rowVersion  Int        @default(0) @map("row_version")

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  praticien     Praticien?     @relation(fields: [praticienId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  consultations Consultation[]
  rappels       Rappel[]

  @@index([hopitalId, praticienId, debut])
  @@index([hopitalId, patientId])
  @@map("rendez_vous")
}

// --------------------------- Consultations ----------------------------------

model Consultation {
  id               String    @id @default(uuid()) @db.Uuid
  hopitalId        String    @map("hopital_id") @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  praticienId      String?   @map("praticien_id") @db.Uuid
  rendezVousId     String?   @map("rendez_vous_id") @db.Uuid
  dateConsultation DateTime  @default(now()) @map("date_consultation") @db.Timestamptz
  motif            String?
  observations     String?
  diagnostic       String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion       Int       @default(0) @map("row_version")

  hopital    Hopital     @relation(fields: [hopitalId], references: [id])
  patient    Patient     @relation(fields: [patientId], references: [id])
  praticien  Praticien?  @relation(fields: [praticienId], references: [id])
  rendezVous RendezVous? @relation(fields: [rendezVousId], references: [id])
  factures   Facture[]

  @@index([hopitalId, patientId, dateConsultation])
  @@map("consultations")
}

// ---------------------------- Facturation -----------------------------------

model Facture {
  id             String        @id @default(uuid()) @db.Uuid
  hopitalId      String        @map("hopital_id") @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  consultationId String?       @map("consultation_id") @db.Uuid
  numero         String
  dateFacture    DateTime      @default(now()) @map("date_facture") @db.Date
  montantTotal   Decimal       @default(0) @map("montant_total") @db.Decimal(12, 2)
  montantPaye    Decimal       @default(0) @map("montant_paye") @db.Decimal(12, 2)
  devise         String        @default("XAF") @db.Char(3)
  statut         StatutFacture @default(ouverte)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  rowVersion     Int           @default(0) @map("row_version")

  hopital      Hopital        @relation(fields: [hopitalId], references: [id])
  patient      Patient        @relation(fields: [patientId], references: [id])
  consultation Consultation?  @relation(fields: [consultationId], references: [id])
  lignes       LigneFacture[]
  paiements    Paiement[]

  @@unique([hopitalId, numero])
  @@map("factures")
}

model LigneFacture {
  id           String   @id @default(uuid()) @db.Uuid
  hopitalId    String   @map("hopital_id") @db.Uuid
  factureId    String   @map("facture_id") @db.Uuid
  acteId       String?  @map("acte_id") @db.Uuid
  libelle      String
  quantite     Int      @default(1)
  prixUnitaire Decimal  @map("prix_unitaire") @db.Decimal(12, 2)
  // montant = quantite * prixUnitaire â€” Ã  calculer cÃ´tÃ© appli, ou via colonne
  // gÃ©nÃ©rÃ©e STORED ajoutÃ©e par migration SQL manuelle.
  montant      Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion   Int      @default(0) @map("row_version")

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  acte    Acte?   @relation(fields: [acteId], references: [id])

  @@index([hopitalId, factureId])
  @@map("lignes_facture")
}

// ----------------------------- Paiements ------------------------------------

model Paiement {
  id              String        @id @default(uuid()) @db.Uuid
  hopitalId       String        @map("hopital_id") @db.Uuid
  factureId       String        @map("facture_id") @db.Uuid
  montant         Decimal       @db.Decimal(12, 2)
  devise          String        @default("XAF") @db.Char(3)
  moyen           MoyenPaiement
  campayReference String?       @map("campay_reference")
  campayStatut    String?       @map("campay_statut")
  telephonePayeur String?       @map("telephone_payeur")
  datePaiement    DateTime      @default(now()) @map("date_paiement") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz
  rowVersion      Int           @default(0) @map("row_version")

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  facture Facture @relation(fields: [factureId], references: [id])

  @@index([hopitalId, factureId])
  @@index([campayReference])
  @@map("paiements")
}

// ------------------------------ Rappels -------------------------------------

model Rappel {
  id           String       @id @default(uuid()) @db.Uuid
  hopitalId    String       @map("hopital_id") @db.Uuid
  rendezVousId String       @map("rendez_vous_id") @db.Uuid
  canal        CanalRappel
  destinataire String
  planifiePour DateTime     @map("planifie_pour") @db.Timestamptz
  statut       StatutRappel @default(en_attente)
  envoyeLe     DateTime?    @map("envoye_le") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion   Int          @default(0) @map("row_version")

  hopital    Hopital    @relation(fields: [hopitalId], references: [id])
  rendezVous RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)

  @@index([hopitalId, statut, planifiePour])
  @@map("rappels")
}

// --------------------------- Journal d'audit --------------------------------

model JournalAudit {
  id            BigInt   @id @default(autoincrement())
  hopitalId     String   @map("hopital_id") @db.Uuid
  utilisateurId String?  @map("utilisateur_id") @db.Uuid
  action        String
  entite        String
  entiteId      String?  @map("entite_id") @db.Uuid
  details       Json?
  horodatage    DateTime @default(now()) @db.Timestamptz

  hopital     Hopital      @relation(fields: [hopitalId], references: [id])
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])

  @@index([hopitalId, horodatage])
  @@map("journal_audit")
}
