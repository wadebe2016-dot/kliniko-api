// =============================================================================
// KLINIKO - schema.prisma (MVP)
// Backend kliniko-api (NestJS + Prisma) - reconstitue le 28/07/2026
// -----------------------------------------------------------------------------
// Principes repris du socle valide :
//   - Multi-tenant : chaque modele metier porte hopitalId (isolation par clinique)
//   - Offline-first : UUID generes cote client, createdAt/updatedAt/deletedAt +
//     rowVersion pour la detection de conflits a la synchro
//   - Facturation Mobile Money : paiements references a Campay
//
// A COMPLETER PAR UNE MIGRATION SQL MANUELLE (Prisma ne sait pas les exprimer) :
//   1. Row-Level Security (RLS) : politiques d'isolation par hopital_id
//   2. Trigger d'auto-increment de row_version a chaque UPDATE
//   3. Colonne calculee `montant` de LigneFacture (sinon la calculer cote appli)
//   -> je fournis cette migration separement sur demande.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------- Enums ----------------------------------------

enum Sexe {
  M
  F
}

enum StatutRdv {
  planifie
  confirme
  honore
  annule
  absent
}

enum OrigineRdv {
  clinique
  patient
}

enum StatutFacture {
  ouverte
  partielle
  reglee
  annulee
}

enum MoyenPaiement {
  mobile_money
  especes
}

enum CanalRappel {
  whatsapp
  sms
}

enum StatutRappel {
  en_attente
  envoye
  echec
}

// ----------------------------- Tenant ---------------------------------------

model Hopital {
  id            String    @id @default(uuid()) @db.Uuid
  nom           String
  code          String    @unique @db.Citext
  ville         String?
  telephone     String?
  campayAppId   String?   @map("campay_app_id")
  visiblePublic Boolean   @default(false) @map("visible_public")
  adresse       String?
  presentation  String?
  actif         Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion    Int       @default(0) @map("row_version")

  utilisateurs          Utilisateur[]
  roles                 Role[]
  services              Service[]
  unitesSoins           UniteSoins[]
  praticiens            Praticien[]
  actes                 Acte[]
  tarifs                Tarif[]
  patients              Patient[]
  rendezVous            RendezVous[]
  consultations         Consultation[]
  factures              Facture[]
  lignesFacture         LigneFacture[]
  paiements             Paiement[]
  rappels               Rappel[]
  medicaments           Medicament[]
  ordonnances           Ordonnance[]
  lignesOrdonnance      LigneOrdonnance[]
  journalAudit          JournalAudit[]
  horaireTravails       HoraireTravail[]
  indisponibilites      Indisponibilite[]
  comptePatientDossiers ComptePatientDossier[]
  mouvementStocks       MouvementStock[]
  chambres              Chambre[]
  hospitalisations      Hospitalisation[]
  consommables          Consommable[]
  mouvementConsommables MouvementConsommable[]
  actifs                Actif[]
  evenementActifs       EvenementActif[]
  personnels            Personnel[]
  compteTresoreries     CompteTresorerie[]
  categorieTresoreries  CategorieTresorerie[]
  mouvementTresoreries  MouvementTresorerie[]
  ligneBudgets          LigneBudget[]
  centreCouts           CentreCout[]
  interventionActifs    InterventionActif[]
  contrats              Contrat[]
  parametresPaie        ParametresPaie?
  trancheIrpps          TrancheIrpp[]
  bulletinPaies         BulletinPaie[]
  parametresConges      ParametresConges?
  demandeConges         DemandeConge[]

  @@map("hopitaux")
}

// ----------------------------- RBAC -----------------------------------------

model Utilisateur {
  id                String     @id @default(uuid()) @db.Uuid
  hopitalId         String     @map("hopital_id") @db.Uuid
  email             String     @db.Citext
  personnelId       String?    @map("personnel_id") @db.Uuid
  personnelFiche    Personnel? @relation(fields: [personnelId], references: [id])
  motDePasse        String     @map("mot_de_passe") // hash argon2/bcrypt
  nom               String
  prenom            String?
  telephone         String?
  actif             Boolean    @default(true)
  derniereConnexion DateTime?  @map("derniere_connexion") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz
  rowVersion        Int        @default(0) @map("row_version")

  hopital    Hopital           @relation(fields: [hopitalId], references: [id])
  roles      UtilisateurRole[]
  praticiens Praticien[]
  audit      JournalAudit[]

  @@unique([hopitalId, email])
  @@map("utilisateurs")
}

model Role {
  id         String   @id @default(uuid()) @db.Uuid
  hopitalId  String   @map("hopital_id") @db.Uuid
  code       String
  libelle    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion Int      @default(0) @map("row_version")

  hopital      Hopital           @relation(fields: [hopitalId], references: [id])
  permissions  RolePermission[]
  utilisateurs UtilisateurRole[]

  @@unique([hopitalId, code])
  @@map("roles")
}

model Permission {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  libelle String
  module  String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UtilisateurRole {
  utilisateurId String @map("utilisateur_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, roleId])
  @@map("utilisateur_roles")
}

// --------------------------- Referentiels -----------------------------------

model Service {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  libelle    String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital     Hopital      @relation(fields: [hopitalId], references: [id])
  unitesSoins UniteSoins[]
  praticiens  Praticien[]
  rendezVous  RendezVous[]

  @@map("services")
}

model UniteSoins {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  serviceId  String?   @map("service_id") @db.Uuid
  libelle    String
  nbLits     Int       @default(0) @map("nb_lits")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital Hopital  @relation(fields: [hopitalId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@map("unites_soins")
}

model Praticien {
  id            String    @id @default(uuid()) @db.Uuid
  hopitalId     String    @map("hopital_id") @db.Uuid
  utilisateurId String?   @map("utilisateur_id") @db.Uuid
  serviceId     String?   @map("service_id") @db.Uuid
  nom           String
  prenom        String?
  specialite    String?
  visiblePublic Boolean   @default(false) @map("visible_public")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion    Int       @default(0) @map("row_version")

  hopital          Hopital           @relation(fields: [hopitalId], references: [id])
  utilisateur      Utilisateur?      @relation(fields: [utilisateurId], references: [id])
  service          Service?          @relation(fields: [serviceId], references: [id])
  rendezVous       RendezVous[]
  consultations    Consultation[]
  ordonnances      Ordonnance[]
  horaireTravails  HoraireTravail[]
  indisponibilites Indisponibilite[]
  hospitalisations Hospitalisation[]

  @@map("praticiens")
}

model Acte {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  code       String
  libelle    String
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  tarifs        Tarif[]
  lignesFacture LigneFacture[]

  @@unique([hopitalId, code])
  @@map("actes")
}

model Tarif {
  id         String    @id @default(uuid()) @db.Uuid
  hopitalId  String    @map("hopital_id") @db.Uuid
  acteId     String    @map("acte_id") @db.Uuid
  montant    Decimal   @db.Decimal(12, 2)
  devise     String    @default("XAF") @db.Char(3)
  dateDebut  DateTime  @default(now()) @map("date_debut") @db.Date
  dateFin    DateTime? @map("date_fin") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion Int       @default(0) @map("row_version")

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  acte    Acte    @relation(fields: [acteId], references: [id])

  @@map("tarifs")
}

// ----------------------------- Patients -------------------------------------

model Patient {
  id            String    @id @default(uuid()) @db.Uuid
  hopitalId     String    @map("hopital_id") @db.Uuid
  numeroDossier String    @map("numero_dossier")
  nom           String
  prenom        String?
  dateNaissance DateTime? @map("date_naissance") @db.Date
  sexe          Sexe?
  telephone     String?
  adresse       String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion    Int       @default(0) @map("row_version")

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  rendezVous    RendezVous[]
  consultations Consultation[]
  factures      Facture[]

  ordonnances           Ordonnance[]
  comptePatientDossiers ComptePatientDossier[]
  hospitalisations      Hospitalisation[]

  @@unique([hopitalId, numeroDossier])
  @@index([hopitalId, nom])
  @@index([hopitalId, telephone])
  @@map("patients")
}

// --------------------------- Rendez-vous ------------------------------------

model RendezVous {
  id          String         @id @default(uuid()) @db.Uuid
  hopitalId   String         @map("hopital_id") @db.Uuid
  patientId   String         @map("patient_id") @db.Uuid
  praticienId String?        @map("praticien_id") @db.Uuid
  serviceId   String?        @map("service_id") @db.Uuid
  debut       DateTime       @db.Timestamptz
  fin         DateTime?      @db.Timestamptz
  statut      StatutRdv      @default(planifie)
  origine     OrigineRdv     @default(clinique)
  compteId    String?        @map("compte_id") @db.Uuid
  expireA     DateTime?      @map("expire_a") @db.Timestamptz
  motifRefus  String?        @map("motif_refus")
  compte      ComptePatient? @relation(fields: [compteId], references: [id])
  motif       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz
  rowVersion  Int            @default(0) @map("row_version")

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  praticien     Praticien?     @relation(fields: [praticienId], references: [id])
  service       Service?       @relation(fields: [serviceId], references: [id])
  consultations Consultation[]
  rappels       Rappel[]

  @@index([hopitalId, praticienId, debut])
  @@index([hopitalId, patientId])
  @@map("rendez_vous")
}

// --------------------------- Consultations ----------------------------------

model Consultation {
  id               String    @id @default(uuid()) @db.Uuid
  hopitalId        String    @map("hopital_id") @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  praticienId      String?   @map("praticien_id") @db.Uuid
  rendezVousId     String?   @map("rendez_vous_id") @db.Uuid
  dateConsultation DateTime  @default(now()) @map("date_consultation") @db.Timestamptz
  motif            String?
  observations     String?
  diagnostic       String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion       Int       @default(0) @map("row_version")

  hopital    Hopital     @relation(fields: [hopitalId], references: [id])
  patient    Patient     @relation(fields: [patientId], references: [id])
  praticien  Praticien?  @relation(fields: [praticienId], references: [id])
  rendezVous RendezVous? @relation(fields: [rendezVousId], references: [id])
  factures   Facture[]

  ordonnances Ordonnance[]

  @@index([hopitalId, patientId, dateConsultation])
  @@map("consultations")
}

// ---------------------------- Facturation -----------------------------------

model Facture {
  id              String        @id @default(uuid()) @db.Uuid
  hopitalId       String        @map("hopital_id") @db.Uuid
  patientId       String        @map("patient_id") @db.Uuid
  consultationId  String?       @map("consultation_id") @db.Uuid
  numero          String
  dateFacture     DateTime      @default(now()) @map("date_facture") @db.Date
  montantTotal    Decimal       @default(0) @map("montant_total") @db.Decimal(12, 2)
  montantPaye     Decimal       @default(0) @map("montant_paye") @db.Decimal(12, 2)
  devise          String        @default("XAF") @db.Char(3)
  statut          StatutFacture @default(ouverte)
  motifAnnulation String?       @map("motif_annulation")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz
  rowVersion      Int           @default(0) @map("row_version")

  hopital              Hopital               @relation(fields: [hopitalId], references: [id])
  patient              Patient               @relation(fields: [patientId], references: [id])
  consultation         Consultation?         @relation(fields: [consultationId], references: [id])
  lignes               LigneFacture[]
  paiements            Paiement[]
  mouvementStocks      MouvementStock[]
  hospitalisations     Hospitalisation[]
  mouvementTresoreries MouvementTresorerie[]

  @@unique([hopitalId, numero])
  @@map("factures")
}

model LigneFacture {
  id           String   @id @default(uuid()) @db.Uuid
  hopitalId    String   @map("hopital_id") @db.Uuid
  factureId    String   @map("facture_id") @db.Uuid
  acteId       String?  @map("acte_id") @db.Uuid
  libelle      String
  quantite     Int      @default(1)
  prixUnitaire Decimal  @map("prix_unitaire") @db.Decimal(12, 2)
  // montant = quantite * prixUnitaire - a calculer cote appli, ou via colonne
  // generee STORED ajoutee par migration SQL manuelle.
  montant      Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion   Int      @default(0) @map("row_version")

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  acte    Acte?   @relation(fields: [acteId], references: [id])

  @@index([hopitalId, factureId])
  @@map("lignes_facture")
}

// ----------------------------- Paiements ------------------------------------

model Paiement {
  id              String        @id @default(uuid()) @db.Uuid
  hopitalId       String        @map("hopital_id") @db.Uuid
  factureId       String        @map("facture_id") @db.Uuid
  montant         Decimal       @db.Decimal(12, 2)
  devise          String        @default("XAF") @db.Char(3)
  moyen           MoyenPaiement
  campayReference String?       @map("campay_reference")
  campayStatut    String?       @map("campay_statut")
  telephonePayeur String?       @map("telephone_payeur")
  datePaiement    DateTime      @default(now()) @map("date_paiement") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz
  rowVersion      Int           @default(0) @map("row_version")

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  facture Facture @relation(fields: [factureId], references: [id])

  @@index([hopitalId, factureId])
  @@index([campayReference])
  @@map("paiements")
}

// ------------------------------ Rappels -------------------------------------

model Rappel {
  id           String       @id @default(uuid()) @db.Uuid
  hopitalId    String       @map("hopital_id") @db.Uuid
  rendezVousId String       @map("rendez_vous_id") @db.Uuid
  canal        CanalRappel
  destinataire String
  planifiePour DateTime     @map("planifie_pour") @db.Timestamptz
  statut       StatutRappel @default(en_attente)
  envoyeLe     DateTime?    @map("envoye_le") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion   Int          @default(0) @map("row_version")

  hopital    Hopital    @relation(fields: [hopitalId], references: [id])
  rendezVous RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)

  @@index([hopitalId, statut, planifiePour])
  @@map("rappels")
}

// --------------------------- Journal d'audit --------------------------------

model JournalAudit {
  id            BigInt   @id @default(autoincrement())
  hopitalId     String   @map("hopital_id") @db.Uuid
  utilisateurId String?  @map("utilisateur_id") @db.Uuid
  action        String
  entite        String
  entiteId      String?  @map("entite_id") @db.Uuid
  details       Json?
  horodatage    DateTime @default(now()) @db.Timestamptz

  hopital     Hopital      @relation(fields: [hopitalId], references: [id])
  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])

  @@index([hopitalId, horodatage])
  @@map("journal_audit")
}

// ---------------------------- Ordonnances -----------------------------------

enum StatutOrdonnance {
  brouillon
  validee
  annulee
}

model Medicament {
  id           String    @id @default(uuid()) @db.Uuid
  hopitalId    String    @map("hopital_id") @db.Uuid
  code         String?
  denomination String
  forme        String?
  dosage       String?
  prixVente    Decimal?  @map("prix_vente") @db.Decimal(12, 2)
  seuilAlerte  Int       @default(10) @map("seuil_alerte")
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion   Int       @default(0) @map("row_version")

  hopital         Hopital           @relation(fields: [hopitalId], references: [id])
  lignes          LigneOrdonnance[]
  mouvementStocks MouvementStock[]

  @@unique([hopitalId, code])
  @@index([hopitalId, denomination])
  @@map("medicaments")
}

model Ordonnance {
  id              String           @id @default(uuid()) @db.Uuid
  hopitalId       String           @map("hopital_id") @db.Uuid
  patientId       String           @map("patient_id") @db.Uuid
  praticienId     String?          @map("praticien_id") @db.Uuid
  consultationId  String?          @map("consultation_id") @db.Uuid
  numero          String
  dateOrdonnance  DateTime         @default(now()) @map("date_ordonnance") @db.Timestamptz
  statut          StatutOrdonnance @default(brouillon)
  notes           String?
  valideeLe       DateTime?        @map("validee_le") @db.Timestamptz
  annuleeLe       DateTime?        @map("annulee_le") @db.Timestamptz
  motifAnnulation String?          @map("motif_annulation")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz
  rowVersion      Int              @default(0) @map("row_version")

  hopital         Hopital           @relation(fields: [hopitalId], references: [id])
  patient         Patient           @relation(fields: [patientId], references: [id])
  praticien       Praticien?        @relation(fields: [praticienId], references: [id])
  consultation    Consultation?     @relation(fields: [consultationId], references: [id])
  lignes          LigneOrdonnance[]
  mouvementStocks MouvementStock[]

  @@unique([hopitalId, numero])
  @@index([hopitalId, patientId, dateOrdonnance])
  @@map("ordonnances")
}

model LigneOrdonnance {
  id           String   @id @default(uuid()) @db.Uuid
  hopitalId    String   @map("hopital_id") @db.Uuid
  ordonnanceId String   @map("ordonnance_id") @db.Uuid
  medicamentId String?  @map("medicament_id") @db.Uuid
  libelle      String
  posologie    String
  duree        String?
  quantite     String?
  voie         String?
  instructions String?
  ordre        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  rowVersion   Int      @default(0) @map("row_version")

  hopital    Hopital     @relation(fields: [hopitalId], references: [id])
  ordonnance Ordonnance  @relation(fields: [ordonnanceId], references: [id], onDelete: Cascade)
  medicament Medicament? @relation(fields: [medicamentId], references: [id])

  @@index([hopitalId, ordonnanceId])
  @@map("lignes_ordonnance")
}

// -------------------------- Disponibilites ----------------------------------
// Les heures sont stockees en texte "HH:MM" plutot qu'en date : le Cameroun
// est a UTC+1 toute l'annee, sans heure d'ete. Un horaire de travail est une
// regle hebdomadaire, pas un instant ; le melanger avec un fuseau horaire ne
// ferait qu'introduire des bugs de decalage.

model HoraireTravail {
  id           String    @id @default(uuid()) @db.Uuid
  hopitalId    String    @map("hopital_id") @db.Uuid
  praticienId  String    @map("praticien_id") @db.Uuid
  jourSemaine  Int       @map("jour_semaine")
  heureDebut   String    @map("heure_debut")
  heureFin     String    @map("heure_fin")
  dureeCreneau Int       @default(30) @map("duree_creneau")
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion   Int       @default(0) @map("row_version")

  hopital   Hopital   @relation(fields: [hopitalId], references: [id])
  praticien Praticien @relation(fields: [praticienId], references: [id])

  @@index([hopitalId, praticienId, jourSemaine])
  @@map("horaires_travail")
}

// Une indisponibilite sans praticien vaut pour la clinique entiere :
// jour ferie, fermeture exceptionnelle, coupure prolongee.
model Indisponibilite {
  id          String    @id @default(uuid()) @db.Uuid
  hopitalId   String    @map("hopital_id") @db.Uuid
  praticienId String?   @map("praticien_id") @db.Uuid
  debut       DateTime  @db.Timestamptz
  fin         DateTime  @db.Timestamptz
  motif       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion  Int       @default(0) @map("row_version")

  hopital   Hopital    @relation(fields: [hopitalId], references: [id])
  praticien Praticien? @relation(fields: [praticienId], references: [id])

  @@index([hopitalId, praticienId, debut])
  @@index([hopitalId, debut])
  @@map("indisponibilites")
}

// -------------------------- Comptes patients --------------------------------
// Identite GLOBALE d'un patient de l'application grand public : elle n'appartient
// a aucune clinique. Le rattachement aux dossiers (un par clinique) se fait par
// la table compte_patient_dossiers. Aucune donnee medicale ici.

model ComptePatient {
  id            String    @id @default(uuid()) @db.Uuid
  telephone     String    @unique
  nom           String?
  prenom        String?
  dateNaissance DateTime? @map("date_naissance") @db.Date
  sexe          Sexe?
  actif         Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  rowVersion    Int       @default(0) @map("row_version")

  dossiers   ComptePatientDossier[]
  rendezVous RendezVous[]

  @@map("compte_patients")
}

// Code de verification a usage unique, HACHE comme un mot de passe.
model CodeVerification {
  id         String    @id @default(uuid()) @db.Uuid
  telephone  String
  codeHash   String    @map("code_hash")
  expireA    DateTime  @map("expire_a") @db.Timestamptz
  tentatives Int       @default(0)
  consommeLe DateTime? @map("consomme_le") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([telephone, createdAt])
  @@map("codes_verification")
}

// Rattachement d'un compte global au dossier qu'une clinique tient sur lui.
model ComptePatientDossier {
  id        String   @id @default(uuid()) @db.Uuid
  compteId  String   @map("compte_id") @db.Uuid
  hopitalId String   @map("hopital_id") @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  compte  ComptePatient @relation(fields: [compteId], references: [id])
  hopital Hopital       @relation(fields: [hopitalId], references: [id])
  patient Patient       @relation(fields: [patientId], references: [id])

  @@unique([compteId, hopitalId])
  @@map("compte_patient_dossiers")
}

// ------------------------------ Pharmacie -----------------------------------
// Le stock n'est jamais un chiffre qu'on modifie : c'est la somme des
// mouvements. Entree = achat/reception ; sortie = dispensation ;
// ajustement = inventaire (quantite signee).

enum TypeMouvementStock {
  entree
  sortie
  ajustement
}

model MouvementStock {
  id             String             @id @default(uuid()) @db.Uuid
  hopitalId      String             @map("hopital_id") @db.Uuid
  medicamentId   String             @map("medicament_id") @db.Uuid
  type           TypeMouvementStock
  quantite       Int
  datePeremption DateTime?          @map("date_peremption") @db.Date
  prixAchat      Decimal?           @map("prix_achat") @db.Decimal(12, 2)
  ordonnanceId   String?            @map("ordonnance_id") @db.Uuid
  factureId      String?            @map("facture_id") @db.Uuid
  motif          String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz

  hopital    Hopital     @relation(fields: [hopitalId], references: [id])
  medicament Medicament  @relation(fields: [medicamentId], references: [id])
  ordonnance Ordonnance? @relation(fields: [ordonnanceId], references: [id])
  facture    Facture?    @relation(fields: [factureId], references: [id])

  @@index([hopitalId, medicamentId, createdAt])
  @@map("mouvements_stock")
}

// --------------------------- Hospitalisation --------------------------------
// Une chambre a des lits ; un sejour occupe un lit du debut a la sortie.
// A la sortie, la facture (optionnelle) = jours x tarif journalier de la
// chambre. Un lit est occupe s'il porte un sejour en_cours : rien a maintenir.

enum StatutHospitalisation {
  en_cours
  terminee
  annulee
}

model Chambre {
  id              String   @id @default(uuid()) @db.Uuid
  hopitalId       String   @map("hopital_id") @db.Uuid
  numero          String
  categorie       String?
  tarifJournalier Decimal? @map("tarif_journalier") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  lits    Lit[]

  @@unique([hopitalId, numero])
  @@map("chambres")
}

model Lit {
  id        String @id @default(uuid()) @db.Uuid
  chambreId String @map("chambre_id") @db.Uuid
  numero    String

  chambre Chambre           @relation(fields: [chambreId], references: [id])
  sejours Hospitalisation[]

  @@unique([chambreId, numero])
  @@map("lits")
}

model Hospitalisation {
  id          String                @id @default(uuid()) @db.Uuid
  hopitalId   String                @map("hopital_id") @db.Uuid
  patientId   String                @map("patient_id") @db.Uuid
  litId       String                @map("lit_id") @db.Uuid
  praticienId String?               @map("praticien_id") @db.Uuid
  motif       String
  notes       String?
  statut      StatutHospitalisation @default(en_cours)
  dateEntree  DateTime              @default(now()) @map("date_entree") @db.Timestamptz
  dateSortie  DateTime?             @map("date_sortie") @db.Timestamptz
  factureId   String?               @map("facture_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz

  hopital   Hopital    @relation(fields: [hopitalId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  lit       Lit        @relation(fields: [litId], references: [id])
  praticien Praticien? @relation(fields: [praticienId], references: [id])
  facture   Facture?   @relation(fields: [factureId], references: [id])

  @@index([hopitalId, statut])
  @@map("hospitalisations")
}

// ----------------------------- Consommables ---------------------------------
// Le stock non medical (gants, seringues, compresses...) sur la meme
// mecanique que la pharmacie : le stock est la somme des mouvements.
// La sortie est une consommation motivee (service, usage).

model Consommable {
  id           String   @id @default(uuid()) @db.Uuid
  hopitalId    String   @map("hopital_id") @db.Uuid
  code         String?
  designation  String
  unite        String?
  seuilAlerte  Int      @default(10) @map("seuil_alerte")
  prixUnitaire Decimal? @map("prix_unitaire") @db.Decimal(12, 2)
  note         String?
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  hopital    Hopital                @relation(fields: [hopitalId], references: [id])
  mouvements MouvementConsommable[]

  @@unique([hopitalId, designation])
  @@map("consommables")
}

model MouvementConsommable {
  id             String             @id @default(uuid()) @db.Uuid
  hopitalId      String             @map("hopital_id") @db.Uuid
  consommableId  String             @map("consommable_id") @db.Uuid
  type           TypeMouvementStock
  quantite       Int
  dateMouvement  DateTime           @default(now()) @map("date_mouvement") @db.Date
  datePeremption DateTime?          @map("date_peremption") @db.Date
  prixAchat      Decimal?           @map("prix_achat") @db.Decimal(12, 2)
  motif          String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz

  hopital     Hopital     @relation(fields: [hopitalId], references: [id])
  consommable Consommable @relation(fields: [consommableId], references: [id])

  @@index([hopitalId, consommableId, createdAt])
  @@map("mouvements_consommables")
}

// ------------------------------ Patrimoine ----------------------------------
// Les actifs de la clinique : equipements, vehicules, batiments...
// Chaque changement d'etat est trace dans un journal d'evenements.

enum EtatActif {
  en_service
  en_maintenance
  en_panne
  reforme
  bon
  moyen
  en_reparation
  hors_service
  cede
}

model Actif {
  id                String    @id @default(uuid()) @db.Uuid
  hopitalId         String    @map("hopital_id") @db.Uuid
  code              String?
  designation       String
  categorie         String?
  localisation      String?
  dateAcquisition   DateTime? @map("date_acquisition") @db.Date
  valeurAcquisition Decimal?  @map("valeur_acquisition") @db.Decimal(14, 2)
  dureeAmortAnnees  Int?      @map("duree_amort_annees")
  etat              EtatActif @default(bon)
  notes             String?
  fournisseur       String?
  affecteA          String?   @map("affecte_a") @db.Uuid
  actif             Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  hopital       Hopital             @relation(fields: [hopitalId], references: [id])
  affecte       Personnel?          @relation(fields: [affecteA], references: [id])
  interventions InterventionActif[]
  evenements    EvenementActif[]

  @@index([hopitalId, etat])
  @@map("actifs")
}

model EvenementActif {
  id        String   @id @default(uuid()) @db.Uuid
  hopitalId String   @map("hopital_id") @db.Uuid
  actifId   String   @map("actif_id") @db.Uuid
  type      String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  actif   Actif   @relation(fields: [actifId], references: [id])

  @@index([hopitalId, actifId, createdAt])
  @@map("evenements_actifs")
}

// -------------------------- Ressources humaines -----------------------------
// La fiche du personnel separe le NON-SENSIBLE (identite professionnelle,
// visible du module Personnel) du SENSIBLE (contrat, salaire, etat civil),
// reserve a la permission personnel.rh. Principe repris d'Edufo.

enum StatutPersonnel {
  actif
  conge
  suspendu
  parti
}

model Personnel {
  id        String          @id @default(uuid()) @db.Uuid
  hopitalId String          @map("hopital_id") @db.Uuid
  matricule String?
  nom       String
  prenom    String?
  telephone String?
  email     String?
  fonction  String
  service   String?
  statut    StatutPersonnel @default(actif)

  // ---- champs sensibles : permission personnel.rh uniquement ----
  dateNaissance     DateTime? @map("date_naissance") @db.Date
  sexe              Sexe?
  adresse           String?
  cni               String?
  numeroCnps        String?   @map("numero_cnps")
  niu               String?
  situationFamille  String?   @map("situation_famille")
  typeContrat       String?   @map("type_contrat")
  dateEmbauche      DateTime? @map("date_embauche") @db.Date
  dateFinContrat    DateTime? @map("date_fin_contrat") @db.Date
  salaireBase       Decimal?  @map("salaire_base") @db.Decimal(12, 2)
  diplome           String?
  contactUrgenceNom String?   @map("contact_urgence_nom")
  contactUrgenceTel String?   @map("contact_urgence_tel")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  hopital       Hopital        @relation(fields: [hopitalId], references: [id])
  actifs        Actif[]
  contrats      Contrat[]
  bulletinPaies BulletinPaie[]
  demandeConges DemandeConge[]
  utilisateurs  Utilisateur[]

  @@unique([hopitalId, matricule])
  @@index([hopitalId, statut])
  @@map("personnels")
}

// ------------------------------- Tresorerie ---------------------------------
// Recettes, depenses et transferts entre comptes. Le solde d'un compte est
// la somme de ses mouvements, jamais un champ stocke. Les encaissements de
// factures alimentent automatiquement la caisse.

enum TypeCompteTresorerie {
  caisse
  banque
  mobile_money
}

enum SensCategorie {
  recette
  depense
}

enum TypeMouvementTresorerie {
  recette
  depense
  transfert
}

model CompteTresorerie {
  id        String               @id @default(uuid()) @db.Uuid
  hopitalId String               @map("hopital_id") @db.Uuid
  nom       String
  type      TypeCompteTresorerie @default(caisse)
  actif     Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz

  hopital         Hopital               @relation(fields: [hopitalId], references: [id])
  mouvements      MouvementTresorerie[] @relation("compte")
  transfertsRecus MouvementTresorerie[] @relation("compteDest")

  @@unique([hopitalId, nom])
  @@map("comptes_tresorerie")
}

model CategorieTresorerie {
  id        String        @id @default(uuid()) @db.Uuid
  hopitalId String        @map("hopital_id") @db.Uuid
  nom       String
  sens      SensCategorie
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  hopital      Hopital               @relation(fields: [hopitalId], references: [id])
  mouvements   MouvementTresorerie[]
  ligneBudgets LigneBudget[]

  @@unique([hopitalId, nom])
  @@map("categories_tresorerie")
}

model MouvementTresorerie {
  id            String                  @id @default(uuid()) @db.Uuid
  hopitalId     String                  @map("hopital_id") @db.Uuid
  type          TypeMouvementTresorerie
  compteId      String                  @map("compte_id") @db.Uuid
  compteDestId  String?                 @map("compte_dest_id") @db.Uuid
  categorieId   String?                 @map("categorie_id") @db.Uuid
  centreCoutId  String?                 @map("centre_cout_id") @db.Uuid
  libelle       String
  beneficiaire  String?
  montant       Decimal                 @db.Decimal(14, 2)
  dateMouvement DateTime                @default(now()) @map("date_mouvement") @db.Date
  factureId     String?                 @map("facture_id") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz

  hopital    Hopital              @relation(fields: [hopitalId], references: [id])
  compte     CompteTresorerie     @relation("compte", fields: [compteId], references: [id])
  compteDest CompteTresorerie?    @relation("compteDest", fields: [compteDestId], references: [id])
  categorie  CategorieTresorerie? @relation(fields: [categorieId], references: [id])
  centreCout CentreCout?          @relation(fields: [centreCoutId], references: [id])
  facture    Facture?             @relation(fields: [factureId], references: [id])

  @@index([hopitalId, dateMouvement])
  @@map("mouvements_tresorerie")
}

// Controle de gestion : une ligne de budget par categorie et par annee.
// Le realise n'est jamais stocke - il est calcule depuis les mouvements.
model LigneBudget {
  id           String   @id @default(uuid()) @db.Uuid
  hopitalId    String   @map("hopital_id") @db.Uuid
  annee        Int
  categorieId  String   @map("categorie_id") @db.Uuid
  montantPrevu Decimal  @map("montant_prevu") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  hopital   Hopital             @relation(fields: [hopitalId], references: [id])
  categorie CategorieTresorerie @relation(fields: [categorieId], references: [id])

  @@unique([hopitalId, annee, categorieId])
  @@map("lignes_budget")
}

// Analytique : les centres de cout de la clinique (services). Chaque
// mouvement peut etre impute a un centre ; le reste est "non impute".
model CentreCout {
  id        String   @id @default(uuid()) @db.Uuid
  hopitalId String   @map("hopital_id") @db.Uuid
  code      String
  nom       String
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  hopital    Hopital               @relation(fields: [hopitalId], references: [id])
  mouvements MouvementTresorerie[]

  @@unique([hopitalId, code])
  @@map("centres_cout")
}

// Interventions de maintenance : panne/reparation ouverte -> actif
// "en_reparation" ; derniere intervention cloturee -> retour a "bon".
model InterventionActif {
  id               String   @id @default(uuid()) @db.Uuid
  hopitalId        String   @map("hopital_id") @db.Uuid
  actifId          String   @map("actif_id") @db.Uuid
  type             String   @default("panne")
  description      String
  cout             Decimal  @default(0) @db.Decimal(14, 2)
  statut           String   @default("ouverte")
  dateIntervention DateTime @default(now()) @map("date_intervention") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  hopital Hopital @relation(fields: [hopitalId], references: [id])
  actif   Actif   @relation(fields: [actifId], references: [id])

  @@index([hopitalId, actifId, statut])
  @@map("interventions_actifs")
}

// Contrats (bail, assurance, maintenance, travail...) : le statut
// temporel est TOUJOURS calcule a la lecture, jamais stocke.
model Contrat {
  id            String    @id @default(uuid()) @db.Uuid
  hopitalId     String    @map("hopital_id") @db.Uuid
  type          String    @default("prestataire")
  objet         String
  cocontractant String?
  personnelId   String?   @map("personnel_id") @db.Uuid
  reference     String?
  dateDebut     DateTime? @map("date_debut") @db.Date
  dateFin       DateTime? @map("date_fin") @db.Date
  montant       Decimal   @default(0) @db.Decimal(14, 2)
  resilie       Boolean   @default(false)
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  hopital   Hopital    @relation(fields: [hopitalId], references: [id])
  personnel Personnel? @relation(fields: [personnelId], references: [id])

  @@index([hopitalId, dateFin])
  @@map("contrats")
}

// --------------------------------- Paie -------------------------------------
// Moteur camerounais repris d'Edufo : CNPS salariale sur brut plafonne,
// abattement frais professionnels, IRPP par tranches ANNUELLES ramene au
// mois, CAC sur IRPP. Outil d'aide au calcul, a valider par un comptable.

model ParametresPaie {
  id                 String   @id @default(uuid()) @db.Uuid
  hopitalId          String   @unique @map("hopital_id") @db.Uuid
  tauxCnpsSalarial   Decimal  @default(4.2) @map("taux_cnps_salarial") @db.Decimal(6, 3)
  plafondCnps        Decimal  @default(750000) @map("plafond_cnps") @db.Decimal(14, 2)
  abattementFraisPct Decimal  @default(30) @map("abattement_frais_pct") @db.Decimal(6, 2)
  cacPct             Decimal  @default(10) @map("cac_pct") @db.Decimal(6, 2)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  hopital Hopital @relation(fields: [hopitalId], references: [id])

  @@map("parametres_paie")
}

model TrancheIrpp {
  id        String   @id @default(uuid()) @db.Uuid
  hopitalId String   @map("hopital_id") @db.Uuid
  borneMin  Decimal  @default(0) @map("borne_min") @db.Decimal(14, 2)
  borneMax  Decimal? @map("borne_max") @db.Decimal(14, 2)
  taux      Decimal  @default(0) @db.Decimal(6, 2)
  ordre     Int      @default(0)

  hopital Hopital @relation(fields: [hopitalId], references: [id])

  @@index([hopitalId, ordre])
  @@map("tranches_irpp")
}

model BulletinPaie {
  id              String    @id @default(uuid()) @db.Uuid
  hopitalId       String    @map("hopital_id") @db.Uuid
  personnelId     String    @map("personnel_id") @db.Uuid
  mois            Int
  annee           Int
  salaireBase     Decimal   @default(0) @map("salaire_base") @db.Decimal(14, 2)
  totalPrimes     Decimal   @default(0) @map("total_primes") @db.Decimal(14, 2)
  primesDetail    String?   @map("primes_detail")
  brut            Decimal   @default(0) @db.Decimal(14, 2)
  cnps            Decimal   @default(0) @db.Decimal(14, 2)
  irpp            Decimal   @default(0) @db.Decimal(14, 2)
  cac             Decimal   @default(0) @db.Decimal(14, 2)
  autresRetenues  Decimal   @default(0) @map("autres_retenues") @db.Decimal(14, 2)
  net             Decimal   @default(0) @db.Decimal(14, 2)
  statutVersement String    @default("en_attente") @map("statut_versement")
  dateVersement   DateTime? @map("date_versement") @db.Date
  modeVersement   String?   @map("mode_versement")
  genereLe        DateTime  @default(now()) @map("genere_le") @db.Timestamptz

  hopital   Hopital   @relation(fields: [hopitalId], references: [id])
  personnel Personnel @relation(fields: [personnelId], references: [id])

  @@unique([hopitalId, personnelId, mois, annee])
  @@index([hopitalId, annee, mois])
  @@map("bulletins_paie")
}

// -------------------------------- Conges ------------------------------------
// Demandes de conges : jours OUVRABLES (lun-ven) calcules a la creation,
// workflow en_attente -> approuve / refuse. Le solde annuel = jours acquis
// (parametre clinique) - jours approuves de l'annee ; toujours calcule.

model ParametresConges {
  id                String   @id @default(uuid()) @db.Uuid
  hopitalId         String   @unique @map("hopital_id") @db.Uuid
  joursAcquisAnnuel Int      @default(18) @map("jours_acquis_annuel")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  hopital Hopital @relation(fields: [hopitalId], references: [id])

  @@map("parametres_conges")
}

model DemandeConge {
  id                    String    @id @default(uuid()) @db.Uuid
  hopitalId             String    @map("hopital_id") @db.Uuid
  personnelId           String    @map("personnel_id") @db.Uuid
  type                  String    @default("annuel")
  dateDebut             DateTime  @map("date_debut") @db.Date
  dateFin               DateTime  @map("date_fin") @db.Date
  nbJoursOuvrables      Int       @map("nb_jours_ouvrables")
  motif                 String?
  statut                String    @default("en_attente")
  commentaireValidation String?   @map("commentaire_validation")
  valideLe              DateTime? @map("valide_le") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  hopital   Hopital   @relation(fields: [hopitalId], references: [id])
  personnel Personnel @relation(fields: [personnelId], references: [id])

  @@index([hopitalId, statut])
  @@index([hopitalId, personnelId, dateDebut])
  @@map("demandes_conges")
}
